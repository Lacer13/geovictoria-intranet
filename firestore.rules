rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.get('admin', false) == true || (
          request.auth.token.get('email_verified', false) == true &&
          request.auth.token.get('email', '') != '' &&
          authorizedEmail(request.auth.token.email.lower())
        )
      );
    }
    function authorizedEmail(email) {
      return exists(/databases/$(database)/documents/administrators/$(email)) &&
        get(/databases/$(database)/documents/administrators/$(email)).data.active == true &&
        get(/databases/$(database)/documents/administrators/$(email)).data.role in ['owner', 'admin'];
    }
    function text(value, max) {
      return value is string && value.size() > 0 && value.size() <= max;
    }
    function santaEventValid(data) {
      return data.keys().hasOnly(['title', 'exchangeDate', 'budget', 'notes', 'people', 'participantIds', 'assignments', 'status', 'revision', 'createdBy', 'createdAt', 'updatedAt', 'drawnAt'])
        && text(data.title, 100)
        && data.exchangeDate is string && (data.exchangeDate == '' || data.exchangeDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && data.budget is string && data.budget.size() <= 100
        && data.notes is string && data.notes.size() <= 1000
        && data.people is map && data.participantIds is list
        && data.participantIds.size() <= 100
        && data.participantIds.toSet().size() == data.participantIds.size()
        && data.people.size() == data.participantIds.size()
        && data.people.keys().hasOnly(data.participantIds)
        && data.assignments is map
        && data.status in ['draft', 'drawn', 'archived']
        && data.revision is int && data.revision >= 0
        && data.createdBy is string && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }
    match /portalSettings/secretSantaEmail {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['enabled', 'serviceId', 'templateId', 'publicKey', 'updatedBy', 'updatedAt'])
        && request.resource.data.enabled is bool
        && request.resource.data.serviceId is string && request.resource.data.serviceId.size() <= 100
        && request.resource.data.templateId is string && request.resource.data.templateId.size() <= 100
        && request.resource.data.publicKey is string && request.resource.data.publicKey.size() <= 100
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /secretSantaEvents/{eventId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && santaEventValid(request.resource.data)
        && request.resource.data.status == 'draft' && request.resource.data.assignments.size() == 0
        && !request.resource.data.keys().hasAny(['drawnAt'])
        && request.resource.data.revision == 0 && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() && santaEventValid(request.resource.data)
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt && (
          (resource.data.status == 'draft' && request.resource.data.status == 'draft'
            && request.resource.data.assignments.size() == 0
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'exchangeDate', 'budget', 'notes', 'people', 'participantIds', 'revision', 'updatedAt'])) ||
          (resource.data.status == 'draft' && request.resource.data.status == 'drawn'
            && request.resource.data.participantIds.size() >= 2
            && request.resource.data.drawnAt == request.time
            && request.resource.data.assignments.size() == resource.data.participantIds.size()
            && request.resource.data.assignments.keys().hasOnly(resource.data.participantIds)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'assignments', 'drawnAt', 'revision', 'updatedAt'])) ||
          (resource.data.status in ['drawn', 'archived'] && request.resource.data.status in ['drawn', 'archived']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'revision', 'updatedAt']))
        );
      allow delete: if false;
      match /deliveries/{giverId} {
        function validDelivery(data) {
          return data.keys().hasOnly(['state', 'attemptId', 'attempts', 'startedAt', 'updatedAt', 'provider', 'lastError'])
            && data.state in ['sending', 'accepted', 'failed', 'uncertain']
            && data.attemptId.matches('^[a-f0-9]{32}$')
            && data.attempts is int && data.attempts > 0
            && data.startedAt is timestamp && data.updatedAt == request.time
            && data.provider in ['emailjs', 'demo']
            && data.lastError is string && data.lastError.size() <= 500;
        }
        function eventReady() {
          let event = get(/databases/$(database)/documents/secretSantaEvents/$(eventId)).data;
          return event.status == 'drawn' && giverId in event.participantIds;
        }
        allow read: if isAdmin();
        allow create: if isAdmin() && eventReady() && validDelivery(request.resource.data)
          && request.resource.data.state == 'sending' && request.resource.data.attempts == 1
          && request.resource.data.startedAt == request.time;
        allow update: if isAdmin() && eventReady() && validDelivery(request.resource.data) && (
          (resource.data.state == 'sending' && request.resource.data.state in ['accepted', 'failed', 'uncertain']
            && request.resource.data.attemptId == resource.data.attemptId
            && request.resource.data.attempts == resource.data.attempts
            && request.resource.data.startedAt == resource.data.startedAt
            && request.resource.data.provider == resource.data.provider) ||
          (request.resource.data.state == 'sending'
            && (resource.data.state != 'sending' || request.time >= resource.data.startedAt + duration.value(90, 's'))
            && request.resource.data.attemptId != resource.data.attemptId
            && request.resource.data.attempts == resource.data.attempts + 1
            && request.resource.data.startedAt == request.time)
        );
        allow delete: if false;
      }
    }
    match /secretSantaCards/{cardId} {
      function activeCard() {
        return cardId.matches('^[a-f0-9]{64}$')
          && get(/databases/$(database)/documents/secretSantaEvents/$(resource.data.eventId)).data.status == 'drawn';
      }
      function cardMatchesDraw() {
        let data = request.resource.data;
        let event = getAfter(/databases/$(database)/documents/secretSantaEvents/$(data.eventId)).data;
        return data.keys().hasOnly(['eventId', 'giverId', 'giverName', 'recipientId', 'recipientName', 'title', 'exchangeDate', 'budget', 'notes', 'createdAt'])
          && cardId.matches('^[a-f0-9]{64}$') && event.status == 'drawn'
          && event.drawnAt == request.time && data.createdAt == request.time
          && data.giverId in event.participantIds && data.recipientId in event.participantIds
          && data.giverId != data.recipientId
          && event.assignments[data.giverId].cardId == cardId
          && event.assignments[data.giverId].recipientId == data.recipientId
          && data.giverName == event.people[data.giverId].name
          && data.recipientName == event.people[data.recipientId].name
          && data.title == event.title && data.exchangeDate == event.exchangeDate
          && data.budget == event.budget && data.notes == event.notes;
      }
      allow get: if isAdmin() || activeCard();
      allow list: if false;
      allow create: if isAdmin() && cardMatchesDraw();
      allow update, delete: if false;
    }
    // Live quiz: private authoring, public stage, capability-protected answers.
    function quizCode(code) { return code.matches('^[A-HJ-NP-Z2-9]{8}$'); }
    function quizOptions(options) {
      return options is list && options.size() == 4
        && options[0] is string && options[0].size() <= 150
        && options[1] is string && options[1].size() <= 150
        && options[2] is string && options[2].size() <= 150
        && options[3] is string && options[3].size() <= 150;
    }
    function quizQuestion(q) {
      return q is map && q.keys().hasOnly(['prompt', 'options', 'correctIndex', 'seconds'])
        && q.prompt is string && q.prompt.size() <= 500
        && q.options is list && q.options.size() == 4
        && q.correctIndex is int && q.correctIndex >= -1 && q.correctIndex <= 3
        && q.seconds is int && q.seconds >= 10 && q.seconds <= 90;
    }
    match /quizEvents/{code} {
      function validEvent(d) {
        return quizCode(code) && d.keys().hasOnly(['title', 'questions', 'status', 'revision', 'createdBy', 'createdAt', 'updatedAt'])
          && text(d.title, 100) && d.questions is list && d.questions.size() == 8
          && quizQuestion(d.questions[0]) && quizQuestion(d.questions[1])
          && quizQuestion(d.questions[2]) && quizQuestion(d.questions[3])
          && quizQuestion(d.questions[4]) && quizQuestion(d.questions[5])
          && quizQuestion(d.questions[6]) && quizQuestion(d.questions[7])
          && d.status in ['draft', 'live', 'finished', 'archived']
          && d.revision is int && d.updatedAt == request.time;
      }
      allow read: if isAdmin();
      allow create: if isAdmin() && validEvent(request.resource.data)
        && request.resource.data.status == 'draft' && request.resource.data.revision == 0
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() && validEvent(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.revision == resource.data.revision + 1
        && ((resource.data.status == 'draft' && request.resource.data.status == 'draft')
          || (request.resource.data.questions == resource.data.questions && request.resource.data.title == resource.data.title
            && ((resource.data.status == 'draft' && request.resource.data.status == 'live')
              || (resource.data.status == 'live' && request.resource.data.status == 'finished')
              || (resource.data.status != 'archived' && request.resource.data.status == 'archived'))));
      allow delete: if false;
    }
    match /quizRooms/{code} {
      function room() { return get(/databases/$(database)/documents/quizRooms/$(code)).data; }
      function active() { return quizCode(code) && room().status != 'archived'; }
      function lobby() { return quizCode(code) && room().status == 'lobby'; }
      function validRoom(d) {
        return quizCode(code) && d.keys().hasOnly(['title', 'status', 'questionIndex', 'question', 'startedAt', 'correctIndex', 'answerCounts', 'leaderboard', 'createdBy', 'createdAt', 'updatedAt'])
          && text(d.title, 100) && d.status in ['lobby', 'question', 'closing', 'reveal', 'ranking', 'finished', 'archived']
          && d.questionIndex is int && d.questionIndex >= -1 && d.questionIndex <= 7
          && d.leaderboard is list && d.leaderboard.size() <= 200
          && d.answerCounts is list && d.answerCounts.size() == 4
          && d.updatedAt == request.time
          && (d.question == null || (d.question is map && d.question.keys().hasOnly(['prompt', 'options', 'seconds', 'bonus'])
            && text(d.question.prompt, 500) && quizOptions(d.question.options)
            && d.question.seconds is int && d.question.seconds >= 10 && d.question.seconds <= 90 && d.question.bonus is bool))
          && ((d.status in ['lobby', 'question', 'closing', 'archived'] && d.correctIndex == null)
            || (d.status in ['reveal', 'ranking', 'finished'] && d.correctIndex is int && d.correctIndex >= 0 && d.correctIndex <= 3));
      }
      allow get: if quizCode(code);
      allow list: if isAdmin();
      allow create: if isAdmin() && validRoom(request.resource.data)
        && getAfter(/databases/$(database)/documents/quizEvents/$(code)).data.status == 'live'
        && request.resource.data.status == 'lobby' && request.resource.data.questionIndex == -1
        && request.resource.data.question == null && request.resource.data.startedAt == null
        && request.resource.data.leaderboard.size() == 0 && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() && validRoom(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if false;
      match /players/{playerId} {
        allow read: if isAdmin() || active();
        allow create: if lobby() && playerId.matches('^[a-f0-9]{32}$')
          && request.resource.data.keys().hasOnly(['name', 'joinedAt'])
          && text(request.resource.data.name, 32) && request.resource.data.name.size() >= 2
          && request.resource.data.name.matches('^[^/\n\r]+$') && request.resource.data.joinedAt == request.time
          && getAfter(/databases/$(database)/documents/quizRooms/$(code)/credentials/$(playerId)).data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/quizRooms/$(code)/names/$(request.resource.data.name.lower())).data.playerId == playerId
          && getAfter(/databases/$(database)/documents/quizRooms/$(code)/stats/registration).data.lastPlayerId == playerId
          && getAfter(/databases/$(database)/documents/quizRooms/$(code)/stats/registration).data.count == get(/databases/$(database)/documents/quizRooms/$(code)/stats/registration).data.count + 1;
        allow update, delete: if false;
      }
      match /credentials/{playerId} {
        allow read: if isAdmin();
        allow create: if lobby() && playerId.matches('^[a-f0-9]{32}$')
          && request.resource.data.keys().hasOnly(['token', 'createdAt'])
          && request.resource.data.token.matches('^[a-f0-9]{64}$') && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/quizRooms/$(code)/players/$(playerId)).data.joinedAt == request.time;
        allow update, delete: if false;
      }
      match /names/{nameKey} {
        allow get: if isAdmin() || active();
        allow list: if isAdmin();
        allow create: if lobby() && request.resource.data.keys().hasOnly(['playerId', 'createdAt'])
          && request.resource.data.createdAt == request.time
          && nameKey == getAfter(/databases/$(database)/documents/quizRooms/$(code)/players/$(request.resource.data.playerId)).data.name.lower()
          && getAfter(/databases/$(database)/documents/quizRooms/$(code)/players/$(request.resource.data.playerId)).data.joinedAt == request.time;
        allow update, delete: if false;
      }
      match /stats/registration {
        allow read: if isAdmin() || active();
        allow create: if isAdmin() && request.resource.data.keys().hasOnly(['count', 'lastPlayerId', 'updatedAt'])
          && request.resource.data.count == 0 && request.resource.data.lastPlayerId == '' && request.resource.data.updatedAt == request.time;
        allow update: if lobby() && request.resource.data.keys().hasOnly(['count', 'lastPlayerId', 'updatedAt'])
          && request.resource.data.count is int && request.resource.data.count == resource.data.count + 1
          && request.resource.data.count <= 200 && request.resource.data.updatedAt == request.time
          && getAfter(/databases/$(database)/documents/quizRooms/$(code)/players/$(request.resource.data.lastPlayerId)).data.joinedAt == request.time;
        allow delete: if false;
      }
      match /rounds/{index} {
        allow read, create, update: if isAdmin();
        allow delete: if false;
        match /answers/{token} {
          // A 256-bit capability stays only in its owner's browser, never in a QR or player list.
          allow get: if isAdmin() || (active() && token.matches('^[a-f0-9]{64}$'));
          allow list: if isAdmin();
          allow create: if quizCode(code) && token.matches('^[a-f0-9]{64}$')
            && request.resource.data.keys().hasOnly(['playerId', 'selectedIndex', 'submittedAt'])
            && request.resource.data.playerId.matches('^[a-f0-9]{32}$')
            && get(/databases/$(database)/documents/quizRooms/$(code)/credentials/$(request.resource.data.playerId)).data.token == token
            && request.resource.data.selectedIndex is int && request.resource.data.selectedIndex >= 0 && request.resource.data.selectedIndex <= 3
            && request.resource.data.submittedAt == request.time
            && room().status == 'question' && string(room().questionIndex) == index
            && get(/databases/$(database)/documents/quizRooms/$(code)/rounds/$(index)).data.closedAt == null
            && request.time >= get(/databases/$(database)/documents/quizRooms/$(code)/rounds/$(index)).data.startedAt
            && request.time < get(/databases/$(database)/documents/quizRooms/$(code)/rounds/$(index)).data.startedAt + duration.value(get(/databases/$(database)/documents/quizRooms/$(code)/rounds/$(index)).data.seconds, 's');
          allow update, delete: if false;
        }
      }
    }
    match /administrators/{email} {
      allow read: if isAdmin() || (
        request.auth != null &&
        request.auth.token.get('email_verified', false) == true &&
        request.auth.token.get('email', '').lower() == email
      );
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['email', 'role', 'active', 'createdBy', 'createdAt'])
        && request.resource.data.email == email && email == email.lower()
        && text(email, 254) && email.matches('^[^@ /]+@[^@ /]+[.][^@ /]+$')
        && request.resource.data.role == 'admin' && request.resource.data.active == true
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() && resource.data.role == 'admin'
        && email != request.auth.token.get('email', '').lower()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'updatedAt'])
        && request.resource.data.active is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /news/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['title', 'desc', 'type', 'date', 'timestamp'])
        && text(request.resource.data.title, 100)
        && text(request.resource.data.desc, 10000)
        && request.resource.data.type in ['anuncio', 'logro', 'cumpleaños']
        && text(request.resource.data.date, 100)
        && text(request.resource.data.timestamp, 50);
      allow delete: if isAdmin();
    }
    match /directory/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['department', 'name', 'email', 'color'])
        && text(request.resource.data.department, 100)
        && text(request.resource.data.name, 100)
        && text(request.resource.data.email, 254)
        && request.resource.data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && request.resource.data.color.matches('^#[0-9a-fA-F]{6}$');
      allow delete: if isAdmin();
    }
    match /feedbacks/{id} {
      allow read, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['isAnonymous', 'name', 'department', 'message', 'date', 'createdAt'])
        && request.resource.data.isAnonymous is bool
        && text(request.resource.data.name, 100)
        && request.resource.data.department is string
        && request.resource.data.department.size() <= 100
        && (!request.resource.data.isAnonymous || (request.resource.data.name == 'Anónimo' && request.resource.data.department == ''))
        && text(request.resource.data.message, 5000)
        && text(request.resource.data.date, 50)
        && request.resource.data.createdAt == request.time;
      allow update: if false;
    }
    match /leaderboard/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'score', 'date'])
        && text(request.resource.data.name, 50)
        && request.resource.data.score is int
        && request.resource.data.score >= 0 && request.resource.data.score <= 10000000
        && text(request.resource.data.date, 50);
      allow delete: if isAdmin();
      allow update: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
